{#
/**
 * @file
 * daisyUI megamenu v2 — the simplest working setup.
 *
 * A direct port of the daisyUI megamenu docs pattern, fed Drupal's processed
 * menu link tree. Requires NO JavaScript: each top-level button uses the
 * native Popover API (`popovertarget` → `[popover]`), which gives open/close
 * on click, Esc, outside-click (light dismiss) and keyboard support for free.
 * daisyUI's CSS handles positioning and the sliding indicator.
 *
 * Mapping (desktop, lg+):
 * - L1 item with children    → <button popovertarget> + popover
 * - L1 item without children → plain <a> link in the bar
 * - L2 item with children    → column heading, its L3 items the links
 * - L2 leaf items only       → single compact dropdown list
 *
 * Mapping (mobile, below lg, in mobile mode — docs/mobile-navigation-spec.md):
 * - Full-height popover panel pinned below the header
 *   (top: var(--ww-header-height), owned by the navbar component).
 * - Item with children → recursive <details>/<summary> disclosure row;
 *   without → plain <a>. Desktop pairs are hidden below lg and vice versa.
 *
 * daisyUI supports at most 10 popovers per megamenu.
 */
#}
{% set mega =
  html_cva(
    base: [
      'megamenu',
      'bg-[var(--navbar-surface,var(--color-base-100))]',
      'text-[var(--navbar-surface-content,var(--color-base-content))]',
      '[&>.megamenu-active]:bg-current/10'
    ],
    variants: {
      width: {
        default: '',
        wide: 'megamenu-wide w-full',
        full: 'megamenu-full w-full'
      },
      size: {
        'megamenu-xs': 'megamenu-xs',
        'megamenu-sm': 'megamenu-sm',
        'megamenu-md': 'megamenu-md',
        'megamenu-lg': 'megamenu-lg',
        'megamenu-xl': 'megamenu-xl'
      },
      mobile: {
        yes: [
          'mm-mobile-panel',
          'max-lg:[position-area:none]',
          'max-lg:max-h-none',
          'max-lg:[max-block-size:none]',
          'max-lg:megamenu-vertical',
          'max-lg:gap-1',
          'max-lg:overflow-y-auto',
          'max-lg:overscroll-contain',
          'max-lg:m-0',
          'max-lg:fixed',
          'max-lg:inset-x-0',
          'max-lg:top-[var(--ww-header-height,4rem)]',
          'max-lg:h-[calc(100dvh-var(--ww-header-height,4rem))]',
          'max-lg:w-full',
          'max-lg:rounded-none'
        ],
        no: ''
      }
    }
  )
%}

{% set is_mobile = mobile|default(false) ? 'yes' : 'no' %}
{% set width_mode = width|default('wide') %}

{# Orientation threshold for flat submenus: this many direct links (or more)
   switches the desktop panel from one column to two. Omitting the prop
   selects 5, it does not force vertical. #}
{% set horizontal_threshold = horizontal_threshold|default(5) %}

{# Extra container classes. Defaults to the standard chrome; pass your own
   string/array to replace it (e.g. '' for a bare bar inside a navbar).
   Normalize array/string input before handing it to Cva::apply(). #}
{% set additional_classes = megamenu_classes|default('p-2 border border-base-300') %}
{% if additional_classes is iterable %}
  {% set additional_classes = additional_classes|join(' ') %}
{% endif %}

{% set mega_classes =
  mega.apply(
    {
      width: width_mode,
      size: size|default('megamenu-md'),
      mobile: is_mobile
    },
    additional_classes
  )
%}

{% set instance_id = id|default('main') %}

{# Mobile popover mode: the whole megamenu becomes a popover (docs pattern
   "Responsive megamenu"). Below lg it is hidden until an external
   button[popovertarget="mm-{id}"] opens it as a vertical menu; on lg+ the
   `.megamenu { display: flex }` rule keeps the bar visible even with the
   popover attribute present. #}
{% if is_mobile == 'yes' %}
  {% set attributes = attributes.setAttribute('popover', '').setAttribute('id', 'mm-' ~ instance_id) %}
{% endif %}

{# Active-trail emphasis for top-level buttons. Deliberately NOT the
   `megamenu-active` class — that is daisyUI's pointer-events:none indicator
   span and must not land on a button. #}
{% set l1_button =
  html_cva(
    base: ['text-current', 'hover:bg-current/10', 'focus-visible:outline-current'],
    variants: {
      active: {
        yes: 'font-semibold underline underline-offset-4',
        no: ''
      },
      mobile: {
        yes: 'max-lg:hidden',
        no: ''
      }
    }
  )
%}

{# Top-level plain link (childless item): match the button metrics so the bar
   reads uniformly, and mirror the buttons' hover/focus feedback — hover fill
   matches the sliding indicator (current foreground at 10%), while the focus
   ring uses the same palette-aware foreground. #}
{% set l1_link =
  html_cva(
    base: [
      'flex',
      'items-center',
      'px-4',
      'h-[var(--size,2.5rem)]',
      'text-sm',
      'rounded-field',
      'transition-colors',
      'text-current',
      'hover:bg-current/10',
      'focus-visible:outline-2',
      'focus-visible:outline-current',
      'focus-visible:outline-offset-2'
    ],
    variants: {
      active: {
        yes: 'font-semibold underline underline-offset-4',
        no: ''
      },
      mobile: {
        yes: 'max-lg:h-12 max-lg:w-full max-lg:text-lg',
        no: ''
      }
    }
  )
%}

{# Popover panel chrome. The Navbar's semantic surface variables keep desktop
   top-layer popovers and inline mobile panels on the same selected palette.
   In mobile mode the panel is desktop-only (hidden below lg) — the mobile
   submenu is the recursive <details> branch, which drops the bordered-box
   chrome entirely (spec §5.3, §5.7). #}
{% set panel =
  html_cva(
    base: [
      'border',
      'border-current/15',
      'bg-[var(--navbar-surface,var(--color-base-100))]',
      'text-[var(--navbar-surface-content,var(--color-base-content))]',
      'shadow'
    ],
    variants: {
      mobile: {
        yes: ['max-lg:hidden', 'lg:rounded-box', 'lg:p-2'],
        no: 'rounded-box p-2'
      }
    }
  )
%}

{% set panel_classes =
  panel.apply({
    mobile: is_mobile
  })
%}

{# Link lists inside popovers. `gap-1` keeps ~4px between adjacent row
   backgrounds so hover/active rectangles never abut. The focus ring is
   spelled out (width, color, offset) rather than left to daisyUI, which
   otherwise suppresses it inside `.menu`. In mobile mode go full width with
   larger daisyUI menu sizing so tap targets are comfortable on small
   screens. #}
{% set menu_list =
  html_cva(
    base: [
      'menu',
      'w-56',
      'gap-1',
      'p-0',
      '[&_a]:text-current',
      '[&_a:hover]:bg-current/10',
      '[&_a:focus-visible]:outline-solid',
      '[&_a:focus-visible]:outline-2',
      '[&_a:focus-visible]:outline-current',
      '[&_a:focus-visible]:outline-offset-2',
      '[&_.menu-active]:bg-current/15',
      '[&_.menu-active]:text-current'
    ],
    variants: {
      mobile: {
        yes: 'max-lg:menu-lg max-lg:w-full',
        no: ''
      }
    }
  )
%}

{% set menu_list_classes =
  menu_list.apply({
    mobile: is_mobile
  })
%}

{# Wrapper around the column layout. In mobile mode drop the padding and
   tighten the gap so the vertical list reads flush, without staggered
   indents. #}
{% set columns_wrap =
  html_cva(
    base: ['flex', 'items-start', 'gap-6', 'p-2', 'max-lg:flex-col'],
    variants: {
      mobile: {
        yes: 'max-lg:w-full max-lg:gap-2 max-lg:p-0',
        no: ''
      }
    }
  )
%}

{% set columns_wrap_classes =
  columns_wrap.apply({
    mobile: is_mobile
  })
%}

{# Column group headings (L2 with children). daisyUI's menu-title padding is
   wider than the item padding, which reads as a backwards indent in the
   vertical mobile menu — normalise it so titles sit one step in and their
   links (see leaf_link's indent variant) sit one step further. #}
{% set column_title =
  html_cva(
    base: ['menu-title'],
    variants: {
      mobile: {
        yes: 'max-lg:px-4',
        no: ''
      }
    }
  )
%}

{% set column_title_classes =
  column_title.apply({
    mobile: is_mobile
  })
%}

{# Leaf links. Padding is set here rather than inherited from daisyUI's
   `px-3 py-1.5` default so the row height stays deterministic. The indent
   variant pushes L3 links (links under a column heading) one step deeper
   than their heading in the vertical mobile menu; flat submenu links stay at
   heading level. #}
{% set leaf_link =
  html_cva(
    base: ['px-3', 'py-2'],
    variants: {
      active: {
        yes: 'menu-active',
        no: ''
      },
      indent: {
        yes: 'max-lg:pl-8',
        no: ''
      }
    }
  )
%}

{# daisyUI's wide/full modifiers use CSS anchor positioning with the global
   name `--megamenu`, so multiple megamenus on one page all anchor their
   popovers to the LAST container in the DOM. Scope the anchor per instance
   (same trick as the `[anchor-name:--megamenu-x]` examples in the daisyUI
   docs); inline styles because the value is dynamic and Tailwind arbitrary
   classes would be purged.

   Only stretched panels need that container anchor. At `default` width the
   panel is content-sized and must follow its own trigger, so we emit neither
   style and let the popover invoker act as daisyUI's implicit anchor.
   Both values are resolved here so no control structure sits in a tag. #}
{% set anchor_name = '--mm-' ~ instance_id %}
{% set uses_container_anchor = width_mode == 'wide' or width_mode == 'full' %}
{% set container_anchor_attr =
  create_attribute(
    uses_container_anchor
      ? {
        style: 'anchor-name: ' ~ anchor_name
      }
      : {}
  )
%}
{% set panel_anchor_attr =
  create_attribute(
    uses_container_anchor
      ? {
        style: 'position-anchor: ' ~ anchor_name
      }
      : {}
  )
%}

{# One flat submenu column. Shared by the vertical panel and by both halves
   of the horizontal panel so the leaf-link markup exists in exactly one
   place. Macros do not see the template scope, so the list classes and the
   `leaf_link` CVA object are passed in. #}
{% macro flat_list(children, list_classes, link_cva) %}
  <ul class="{{ list_classes }}">
    {% for child in children %}
      {% set leaf_active = child.in_active_trail ? 'yes' : 'no' %}
      <li>
        <a
          href="{{ child.url }}"
          class="{{
          link_cva.apply({
            active: leaf_active,
            indent: 'no'
          })
          }}"
        >
          {{ child.title }}
        </a>
      </li>
    {% endfor %}
  </ul>
{% endmacro %}

{# Recursive mobile renderer: item.below non-empty → <details>/<summary>
   disclosure (active trail pre-opened server-side), empty → leaf link.
   Indent classes must stay statically enumerable for Tailwind; chevron and
   slide behavior live in src/css/components/megamenu.css. #}
{% macro mobile_item(item, depth) %}
  {% import _self as mobile_menu %}

  {% set row =
    html_cva(
      base: [
        'flex',
        'items-center',
        'h-12',
        'w-full',
        'rounded-field',
        'transition-colors',
        'text-current',
        'hover:bg-current/10',
        'focus-visible:outline-2',
        'focus-visible:outline-current',
        'focus-visible:outline-offset-2'
      ],
      variants: {
        depth: {
          d1: 'px-4 text-lg',
          d2: 'pl-8 pr-4 text-base',
          d3: 'pl-12 pr-4 text-base',
          d4: 'pl-16 pr-4 text-base'
        },
        kind: {
          toggle: ['justify-between', 'cursor-pointer', 'select-none', 'list-none'],
          leaf: ''
        },
        active: {
          top: 'font-semibold underline underline-offset-4',
          child: 'menu-active bg-current/15',
          no: ''
        }
      }
    )
  %}

  {% set depth_key = 'd4' %}
  {% if depth <= 1 %}
    {% set depth_key = 'd1' %}
  {% elseif depth == 2 %}
    {% set depth_key = 'd2' %}
  {% elseif depth == 3 %}
    {% set depth_key = 'd3' %}
  {% endif %}

  {% if item.below is not empty %}
    {% set open_attr = item.in_active_trail ? 'open' : '' %}
    {% set toggle_active = 'no' %}
    {% if item.in_active_trail and depth <= 1 %}
      {% set toggle_active = 'top' %}
    {% endif %}
    <details class="mm-disclosure w-full" {{ open_attr }}>
      <summary
        class="{{
        row.apply({
          depth: depth_key,
          kind: 'toggle',
          active: toggle_active
        })
        }}"
      >
        <span>{{ item.title }}</span>
        <span class="mm-chevron shrink-0" aria-hidden="true">
          {{
            include(
              'ww_daisyui_starter:icon',
              {
                icon: 'caret-down',
                icon_size: 'extra-small'
              },
              with_context: false
            )
          }}
        </span>
      </summary>
      {# `flex flex-col gap-1` separates sibling rows at every nested depth;
         the gap lives on the container, never as margins on the links. #}
      <ul class="flex w-full flex-col gap-1">
        {% for child in item.below %}
          <li>{{ mobile_menu.mobile_item(child, depth + 1) }}</li>
        {% endfor %}
      </ul>
    </details>
  {% else %}
    {% set leaf_active = 'no' %}
    {% if item.in_active_trail %}
      {% set leaf_active = depth <= 1 ? 'top' : 'child' %}
    {% endif %}
    <a
      href="{{ item.url }}"
      class="{{
      row.apply({
        depth: depth_key,
        kind: 'leaf',
        active: leaf_active
      })
      }}"
    >
      {{ item.title }}
    </a>
  {% endif %}
{% endmacro %}

{% import _self as mobile_menu %}
{% import _self as mega_menu %}

{# Capture the mobile_bottom slot so we can skip its wrapper entirely when
   no content is passed. Rendered only in mobile mode, below lg, at the end
   of the vertical menu (e.g. a search form). #}
{% set mobile_bottom_content %}
  {% block mobile_bottom %}

  {% endblock %}
{% endset %}

<div {{ container_anchor_attr }} {{ attributes.addClass(mega_classes) }}>
  {# Sliding indicator under the open/active item — pure daisyUI CSS. Pinned
     behind the interactive items (z-0) so its resting position never
     intercepts pointer events. #}
  <span class="megamenu-active z-0"></span>

  {% for item in items %}
    {% if item.below is not empty %}
      {% set popover_id = 'mm-' ~ instance_id ~ '-' ~ loop.index %}
      {% set button_active = item.in_active_trail ? 'yes' : 'no' %}

      <button
        type="button"
        popovertarget="{{ popover_id }}"
        class="{{
        l1_button.apply({
          active: button_active,
          mobile: is_mobile
        })
        }}"
      >
        {{ item.title }}
      </button>

      {# Shape detection: if any L2 item has children, render columns (L2 =
         heading, L3 = links); otherwise render one compact list of links. #}
      {% set has_columns = false %}
      {% for column in item.below %}
        {% if column.below is not empty %}
          {% set has_columns = true %}
        {% endif %}
      {% endfor %}

      <div id="{{ popover_id }}" {{ panel_anchor_attr }} class="{{ panel_classes }}" popover>
        {% if has_columns %}
          <div class="{{ columns_wrap_classes }}">
            {% for column in item.below %}
              <ul class="{{ menu_list_classes }}">
                {% if column.below is not empty %}
                  <li class="{{ column_title_classes }}">{{ column.title }}</li>
                  {% for child in column.below %}
                    {% set leaf_active = child.in_active_trail ? 'yes' : 'no' %}
                    <li>
                      <a
                        href="{{ child.url }}"
                        class="{{
                        leaf_link.apply({
                          active: leaf_active,
                          indent: is_mobile
                        })
                        }}"
                      >
                        {{ child.title }}
                      </a>
                    </li>
                  {% endfor %}
                {% else %}
                  {% set leaf_active = column.in_active_trail ? 'yes' : 'no' %}
                  <li>
                    <a
                      href="{{ column.url }}"
                      class="{{
                      leaf_link.apply({
                        active: leaf_active,
                        indent: 'no'
                      })
                      }}"
                    >
                      {{ column.title }}
                    </a>
                  </li>
                {% endif %}
              </ul>
            {% endfor %}
          </div>
        {% else %}
          {# Auto-orientation: from `horizontal_threshold` links up, the flat
             list splits into two content-sized columns filled down-then-
             across, so Tab order still matches the visual reading order.
             Below the threshold it stays a single column. #}
          {% if (item.below|length) >= horizontal_threshold %}
            {% set split_at = ((item.below|length) / 2)|round(0, 'ceil') %}
            <div class="flex items-start gap-4">
              {{ mega_menu.flat_list(item.below|slice(0, split_at), menu_list_classes, leaf_link) }}
              {{ mega_menu.flat_list(item.below|slice(split_at), menu_list_classes, leaf_link) }}
            </div>
          {% else %}
            {{ mega_menu.flat_list(item.below, menu_list_classes, leaf_link) }}
          {% endif %}
        {% endif %}
      </div>

      {# Mobile sibling of the desktop button+popover pair, same item data. #}
      {% if is_mobile == 'yes' %}
        <div class="w-full lg:hidden">
          {{ mobile_menu.mobile_item(item, 1) }}
        </div>
      {% endif %}
    {% else %}
      {% set link_active = item.in_active_trail ? 'yes' : 'no' %}
      <a
        href="{{ item.url }}"
        class="{{
        l1_link.apply({
          active: link_active,
          mobile: is_mobile
        })
        }}"
      >
        {{ item.title }}
      </a>
    {% endif %}
  {% endfor %}

  {% if is_mobile == 'yes' and mobile_bottom_content|trim is not empty %}
    <div class="mt-2 w-full border-t border-current/15 p-4 lg:hidden">
      {{ mobile_bottom_content }}
    </div>
  {% endif %}
</div>
