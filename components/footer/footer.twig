{% set bg_class_map = {
  default: '',
  'base-200': 'bg-base-200 text-base-content',
  'base-300': 'bg-base-300 text-base-content',
  neutral: 'bg-neutral text-neutral-content',
  primary: 'bg-primary text-primary-content',
  dark: 'bg-gray-900 text-gray-200'
} %}
{% set bg_classes = bg_class_map[bg_color|default('base-200')] ?? bg_class_map['base-200'] %}

{% set variant_val = variant|default('default') %}
{% set padding_val = padding|default('p-10') %}

{% set top_classes = ['footer', variant_val == 'center' ? 'footer-center' : 'sm:footer-horizontal', 'container', 'mx-auto', padding_val] %}

{% set has_top = branding or links or social %}

<footer {{ attributes.addClass([bg_classes]) }}>
  {% if has_top %}
    <div class="{{ top_classes|join(' ') }}">
      {% if branding %}
        <aside>
          {{ branding }}
        </aside>
      {% endif %}
      {{ links }}
      {{ social }}
    </div>
  {% endif %}

  {% if bottom %}
    <div class="{{ has_top ? 'border-t border-base-content/10' }}">
      <div class="footer-center container mx-auto footer p-4">
        {{ bottom }}
      </div>
    </div>
  {% endif %}
</footer>
