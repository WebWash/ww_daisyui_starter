<section class="relative py-34 text-white">
  {% if media.src is not empty %}
    <div class="absolute inset-0 left-[50%] z-[-1] ms-[-50vw] h-full w-screen">
      <img src="{{ media.src }}" alt="{{ media.alt }}" class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-black/40"></div>
    </div>
  {% endif %}

  <div class="relative z-10 container mx-auto px-4">
    <div class="max-w-3xl">
      <h1 class="mb-4 text-4xl font-bold md:text-5xl">{{ heading_text }}</h1>
      <p class="mb-8 text-xl text-white">
        {{ subtitle }}
      </p>
      <a href="{{ link_url }}" class="inline-block rounded-lg bg-white px-6 py-3 font-semibold text-blue-600 no-underline hover:bg-gray-100">
        {{ link_label }}
      </a>
    </div>
  </div>
</section>
