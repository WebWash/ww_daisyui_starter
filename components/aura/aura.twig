{% set aura =
  html_cva(
    base: ['aura', 'flex', 'flex-col', '[&>*]:grow'],
    variants: {
      style: {
        'aura-dual': 'aura-dual',
        'aura-rainbow': 'aura-rainbow',
        'aura-holo': 'aura-holo',
        'aura-gold': 'aura-gold',
        'aura-silver': 'aura-silver',
        'aura-glow': 'aura-glow'
      },
      size: {
        'aura-xs': 'aura-xs',
        'aura-sm': 'aura-sm',
        'aura-md': 'aura-md',
        'aura-lg': 'aura-lg',
        'aura-xl': 'aura-xl'
      },
      colorPalette: {
        'base-100': 'text-base-100',
        'base-200': 'text-base-200',
        'base-300': 'text-base-300',
        neutral: 'text-neutral',
        primary: 'text-primary',
        secondary: 'text-secondary',
        accent: 'text-accent',
        info: 'text-info',
        success: 'text-success',
        warning: 'text-warning',
        error: 'text-error'
      },
      backgroundColorPalette: {
        'base-100': 'bg-[var(--color-base-100)]',
        'base-200': 'bg-[var(--color-base-200)]',
        'base-300': 'bg-[var(--color-base-300)]',
        neutral: 'bg-[var(--color-neutral)]',
        primary: 'bg-[var(--color-primary)]',
        secondary: 'bg-[var(--color-secondary)]',
        accent: 'bg-[var(--color-accent)]',
        info: 'bg-[var(--color-info)]',
        success: 'bg-[var(--color-success)]',
        warning: 'bg-[var(--color-warning)]',
        error: 'bg-[var(--color-error)]'
      },
      duration: {
        'duration-1000': 'duration-1000',
        'duration-2000': 'duration-2000',
        'duration-3000': 'duration-3000'
      },
      padding: {
        sm: 'p-4',
        md: 'p-6',
        lg: 'p-8',
        xl: 'p-12',
        '2xl': 'p-16'
      }
    }
  )
%}

{% set aura_classes =
  aura.apply({
    style: style|default(''),
    size: size|default(''),
    colorPalette: color_palette|default(''),
    backgroundColorPalette: background_color_palette|default(''),
    duration: duration|default(''),
    padding: padding|default('')
  })
%}

{% set is_preview = canvas_is_preview ?? false %}

{% set aura_content %}
  {% block aura_content %}

  {% endblock %}
{% endset %}

{% if is_preview and aura_content|trim is empty %}
  {% set aura_classes = aura_classes ~ ' min-h-24 min-w-24' %}
{% endif %}

<div {{ attributes.addClass(aura_classes) }}>
  {{ aura_content }}
</div>
