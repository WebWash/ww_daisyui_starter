{% set text_variants =
  html_cva(
    base: ['prose'],
    variants: {
      align: {
        left: 'text-left',
        center: 'text-center',
        right: 'text-right'
      },
      textSize: {
        sm: 'text-sm',
        lg: 'text-lg',
        xl: 'text-xl',
        '2xl': 'text-2xl'
      }
    }
  )
%}

<div
  class="{{
  text_variants.apply({
    align: align,
    textSize: text_size
  })
  }}"
>
  {{ text|raw }}
</div>
