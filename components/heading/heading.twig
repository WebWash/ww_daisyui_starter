{% set level = level|default(2) %}
{% set heading_variants =
  html_cva(
    base: [],
    variants: {
      align: {
        left: 'text-left',
        center: 'text-center',
        right: 'text-right'
      },
      textSize: {
        lg: 'text-base md:text-lg',
        xl: 'text-lg md:text-xl',
        '2xl': 'text-xl lg:text-2xl',
        '3xl': 'text-2xl lg:text-3xl',
        '4xl': 'text-2xl md:text-3xl lg:text-4xl',
        '5xl': 'text-3xl md:text-4xl lg:text-5xl',
        '6xl': 'text-4xl md:text-5xl lg:text-6xl',
        '7xl': 'text-5xl md:text-6xl lg:text-7xl',
        '8xl': 'text-6xl md:text-7xl lg:text-8xl'
      }
    }
  )
%}

{% set heading_class_attr =
  heading_variants.apply({
    align: align,
    textSize: text_size
  })
%}

{% if level == 1 %}
  <h1 class="{{ heading_class_attr }}">{{ heading_text }}</h1>
{% elseif level == 2 %}
  <h2 class="{{ heading_class_attr }}">{{ heading_text }}</h2>
{% elseif level == 3 %}
  <h3 class="{{ heading_class_attr }}">{{ heading_text }}</h3>
{% elseif level == 4 %}
  <h4 class="{{ heading_class_attr }}">{{ heading_text }}</h4>
{% elseif level == 5 %}
  <h5 class="{{ heading_class_attr }}">{{ heading_text }}</h5>
{% else %}
  <h6 class="{{ heading_class_attr }}">{{ heading_text }}</h6>
{% endif %}
