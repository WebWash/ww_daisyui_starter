{% if items %}
  {% set classes = [
    'breadcrumbs',
    size|default('text-sm'),
  ] %}
  <nav {{ attributes.addClass(classes).setAttribute('aria-labelledby', 'system-breadcrumb') }}>
    <h2 id="system-breadcrumb" class="sr-only">{{ 'Breadcrumb'|t }}</h2>
    <ul>
      {% for item in items %}
        <li{{ not item.url ? ' aria-current="page"' }}>
          {% if item.url %}
            <a href="{{ item.url }}">{{ item.text }}</a>
          {% else %}
            {{ item.text }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endif %}
