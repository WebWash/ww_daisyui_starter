{#
/**
 * Grid — responsive layout helper.
 *
 * Always 1 column on mobile. At md it goes to 2 columns (or stays at the
 * desktop count when that's 1 or 2). At lg it reaches the configured count.
 */
#}
{% set cols_class =
  {
    1: 'grid-cols-1',
    2: 'grid-cols-1 md:grid-cols-2',
    3: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
    4: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4'
  }[cols|default(3)]
%}

{% set gap_class =
  {
    sm: 'gap-3',
    md: 'gap-6',
    lg: 'gap-10'
  }[gap|default('md')]
%}

<div class="grid {{ cols_class }} {{ gap_class }}">
  {% block items %}
    {{ items }}
  {% endblock %}
</div>
