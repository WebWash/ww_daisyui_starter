{% set is_reverse = reverse_mobile ? 'yes' : 'no' %}

{% set wrapper =
  html_cva(
    base: ['relative mx-auto flex w-full flex-col items-stretch'],
    variants: {
      colorPalette: {
        'base-100': 'bg-base-100 text-base-content',
        'base-200': 'bg-base-200 text-base-content',
        'base-300': 'bg-base-300 text-base-content',
        neutral: 'bg-neutral text-neutral-content',
        primary: 'bg-primary text-primary-content',
        secondary: 'bg-secondary text-secondary-content',
        accent: 'bg-accent text-accent-content',
        info: 'bg-info text-info-content',
        success: 'bg-success text-success-content',
        warning: 'bg-warning text-warning-content',
        error: 'bg-error text-error-content',
        none: '',
      },
      marginBlockStart: {
        '0': 'mt-0',
        '8': 'mt-2',
        '20': 'mt-5',
        '32': 'mt-6 md:mt-7 xl:mt-8',
        '48': 'mt-8 md:mt-10 xl:mt-12',
        '64': 'mt-10 md:mt-13 xl:mt-16',
        '96': 'mt-16 md:mt-20 xl:mt-24',
        '128': 'mt-20 md:mt-24 xl:mt-32',
      },
      marginBlockEnd: {
        '0': 'mb-0',
        '8': 'mb-2',
        '20': 'mb-5',
        '32': 'mb-6 md:mb-7 xl:mb-8',
        '48': 'mb-8 md:mb-10 xl:mb-12',
        '64': 'mb-10 md:mb-13 xl:mb-16',
        '96': 'mb-16 md:mb-20 xl:mb-24',
        '128': 'mb-20 md:mb-24 xl:mb-32',
      },
      paddingBlockStart: {
        '0': 'pt-0',
        '8': 'pt-2',
        '20': 'pt-5',
        '32': 'pt-6 md:pt-7 xl:pt-8',
        '48': 'pt-8 md:pt-10 xl:pt-12',
        '64': 'pt-10 md:pt-13 xl:pt-16',
        '96': 'pt-16 md:pt-20 xl:pt-24',
        '128': 'pt-20 md:pt-24 xl:pt-32',
      },
      paddingBlockEnd: {
        '0': 'pb-0',
        '8': 'pb-2',
        '20': 'pb-5',
        '32': 'pb-6 md:pb-7 xl:pb-8',
        '48': 'pb-8 md:pb-10 xl:pb-12',
        '64': 'pb-10 md:pb-13 xl:pb-16',
        '96': 'pb-16 md:pb-20 xl:pb-24',
        '128': 'pb-20 md:pb-24 xl:pb-32',
      },
    }
  )
%}

{% set wrapper_classes =
  wrapper.apply({
    colorPalette: color_palette|default('none'),
    marginBlockStart: margin_block_start|default('0'),
    marginBlockEnd: margin_block_end|default('0'),
    paddingBlockStart: padding_block_start|default('0'),
    paddingBlockEnd: padding_block_end|default('0'),
  })
%}

{% set content =
  html_cva(
    base: ['relative mx-auto flex w-full flex-col items-stretch'],
    variants: {
      width: {
        '100%': 'lg:max-w-full',
        '90%': 'lg:max-w-9/10',
        '80%': 'lg:max-w-8/10',
        '70%': 'lg:max-w-7/10',
        '60%': 'lg:max-w-6/10',
        '50%': 'lg:max-w-1/2',
      },
    }
  )
%}

{% set content_classes =
  content.apply({
    width: width|default('100%'),
  })
%}

{% set grid =
  html_cva(
    base: ['grid w-full min-w-0'],
    variants: {
      gap: {
        none: 'gap-0',
        xs: 'gap-2',
        sm: 'gap-4',
        md: 'gap-4 md:gap-6 xl:gap-8',
        lg: 'gap-6 md:gap-8 xl:gap-10',
        xl: 'gap-8 md:gap-10 xl:gap-12',
      },
      columns: {
        '1 column': 'grid-cols-1',
        '2 columns': 'md:grid-cols-2',
        '3 columns': 'md:grid-cols-3',
        '4 columns': 'sm:grid-cols-2 lg:grid-cols-4',
        '5 columns': 'sm:grid-cols-2 lg:grid-cols-5',
        '6 columns': 'sm:grid-cols-3 lg:grid-cols-6',
        '2 columns 75%-25%': 'md:grid-cols-[minmax(0,3fr)_minmax(0,1fr)]',
        '2 columns 25%-75%': 'md:grid-cols-[minmax(0,1fr)_minmax(0,3fr)]',
        '2 columns 67%-33%': 'md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]',
        '2 columns 33%-67%': 'md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]',
        '3 columns 50%-25%-25%': 'md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)]',
        '3 columns 25%-25%-50%': 'md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,2fr)]',
      },
      mobileColumns: {
        '1': '',
        '2': 'grid-cols-2',
        '3': 'grid-cols-3',
      },
      reverseMobile: {
        yes: '[&>*:first-child]:order-1 md:[&>*:first-child]:-order-1 [&>*:last-child]:-order-1 md:[&>*:last-child]:order-1',
        no: '',
      },
    },
    compound_variants: [
      {
        columns: ['4 columns'],
        mobileColumns: ['2'],
        class: 'sm:grid-cols-4',
      },
    ]
  )
%}

{% set grid_classes =
  grid.apply({
    gap: gap|default('md'),
    columns: columns|default('2 columns'),
    mobileColumns: mobile_columns|default('1'),
    reverseMobile: is_reverse,
  })
%}

<section class="{{ wrapper_classes }}">
  <div class="{{ content_classes }}">
    <div class="{{ grid_classes }}">
      {% block main_slot %}

      {% endblock %}
    </div>
  </div>
</section>
