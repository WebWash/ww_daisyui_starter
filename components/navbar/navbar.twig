<div {{ attributes.addClass('navbar') }}>
  <div class="navbar-start">
    {% block navbar_start %}
      {{ navbar_start }}
    {% endblock %}
  </div>

  <div class="navbar-center">
    {% block navbar_center %}
      {{ navbar_center }}
    {% endblock %}
  </div>

  <div class="navbar-end gap-2">
    {% block navbar_end %}
      {{ navbar_end }}
    {% endblock %}

    <button type="button" class="btn btn-square btn-ghost lg:hidden" popovertarget="mm-main" aria-label="Open menu">
      {{
        include(
          'ww_daisyui_starter:icon',
          {
            icon: 'list',
            icon_size: 'medium'
          },
          with_context: false
        )
      }}
    </button>
  </div>
</div>
