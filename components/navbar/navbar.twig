{# prettier-ignore-start #}
{% set navbar_cva =
  html_cva(
    base: ['w-full', 'shadow-sm'],
    variants: {
      colorPalette: {
        'base-100': [
          'bg-base-100',
          'text-base-content',
          '[--navbar-surface:var(--color-base-100)]',
          '[--navbar-surface-content:var(--color-base-content)]'
        ],
        'base-200': [
          'bg-base-200',
          'text-base-content',
          '[--navbar-surface:var(--color-base-200)]',
          '[--navbar-surface-content:var(--color-base-content)]'
        ],
        'base-300': [
          'bg-base-300',
          'text-base-content',
          '[--navbar-surface:var(--color-base-300)]',
          '[--navbar-surface-content:var(--color-base-content)]'
        ],
        neutral: [
          'bg-neutral',
          'text-neutral-content',
          '[--navbar-surface:var(--color-neutral)]',
          '[--navbar-surface-content:var(--color-neutral-content)]'
        ],
        primary: [
          'bg-primary',
          'text-primary-content',
          '[--navbar-surface:var(--color-primary)]',
          '[--navbar-surface-content:var(--color-primary-content)]'
        ],
        secondary: [
          'bg-secondary',
          'text-secondary-content',
          '[--navbar-surface:var(--color-secondary)]',
          '[--navbar-surface-content:var(--color-secondary-content)]'
        ],
        accent: [
          'bg-accent',
          'text-accent-content',
          '[--navbar-surface:var(--color-accent)]',
          '[--navbar-surface-content:var(--color-accent-content)]'
        ],
        info: [
          'bg-info',
          'text-info-content',
          '[--navbar-surface:var(--color-info)]',
          '[--navbar-surface-content:var(--color-info-content)]'
        ],
        success: [
          'bg-success',
          'text-success-content',
          '[--navbar-surface:var(--color-success)]',
          '[--navbar-surface-content:var(--color-success-content)]'
        ],
        warning: [
          'bg-warning',
          'text-warning-content',
          '[--navbar-surface:var(--color-warning)]',
          '[--navbar-surface-content:var(--color-warning-content)]'
        ],
        error: [
          'bg-error',
          'text-error-content',
          '[--navbar-surface:var(--color-error)]',
          '[--navbar-surface-content:var(--color-error-content)]'
        ]
      }
    }
  )
%}
{# prettier-ignore-end #}

{% set navbar_content_cva =
  html_cva(
    base: ['navbar', 'px-4', 'lg:px-8'],
    variants: {
      contentWidth: {
        contained: 'container mx-auto',
        full: 'w-full max-w-none'
      }
    }
  )
%}

{% set navbar_classes =
  navbar_cva.apply({
    colorPalette: color_palette|default('base-100')
  })
%}

{% set navbar_content_classes =
  navbar_content_cva.apply({
    contentWidth: content_width|default('contained')
  })
%}

<header {{ attributes.addClass(navbar_classes) }}>
  <div class="{{ navbar_content_classes }}">
    <div class="navbar-start">
      {% block navbar_start %}
        {{ navbar_start }}
      {% endblock %}
    </div>

    <div class="navbar-center">
      {% block navbar_center %}
        {{ navbar_center }}
      {% endblock %}
    </div>

    <div class="navbar-end gap-2">
      {% block navbar_end %}
        {{ navbar_end }}
      {% endblock %}

      <button type="button" class="btn btn-square btn-ghost lg:hidden" popovertarget="mm-main" aria-label="Open menu">
        {{
          include(
            'ww_daisyui_starter:icon',
            {
              icon: 'list',
              icon_size: 'medium'
            },
            with_context: false
          )
        }}
      </button>
    </div>
  </div>
</header>
