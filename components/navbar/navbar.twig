{#
/**
 * @file
 * Site header built on the daisyUI navbar pattern.
 *
 * The menu slot renders the placed main-menu block; its
 * menu--main.html.twig override always outputs the megamenu component
 * (popover container id "mm-main"). On large screens that is the
 * horizontal megamenu; below lg the megamenu hides itself and the
 * hamburger button here opens it as a vertical popover. No drawer, no
 * JavaScript.
 */
#}
<header class="bg-base-100 shadow-sm">
  <div class="navbar container mx-auto px-4 lg:px-8">
    <div class="navbar-start">
      {% if logo %}
        {{ logo }}
      {% else %}
        <a href="/" class="btn btn-ghost text-xl font-bold">{{ site_name }}</a>
      {% endif %}
    </div>

    <div class="navbar-center">
      {% if menu %}
        {{ menu }}
      {% endif %}
    </div>

    <div class="navbar-end gap-2">
      {{ include('ww_daisyui_starter:theme_switcher', {}, with_context: false) }}

      <a href="#" class="btn btn-primary">Premium</a>

      <button type="button" class="btn btn-square btn-ghost lg:hidden" popovertarget="mm-main" aria-label="Open menu">
        {{
          include(
            'ww_daisyui_starter:icon',
            {
              icon: 'list',
              icon_size: 'medium'
            },
            with_context: false
          )
        }}
      </button>
    </div>
  </div>
</header>
