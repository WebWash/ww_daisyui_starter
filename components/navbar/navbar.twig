{% embed 'ww_tailwind_starter:drawer' with { drawer_id: 'mobile-drawer', side: 'end' } %}
  {% block content %}
    <header class="bg-base-100 shadow-sm">
      <div class="navbar container mx-auto px-4 lg:px-8">
        <div class="navbar-start">
          <a href="/" class="btn btn-ghost text-xl font-bold gap-2">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            WebWash
          </a>
        </div>

        <div class="navbar-center max-lg:hidden">
          <ul class="menu menu-horizontal px-1">
            <li><a href="#">Home</a></li>
            <li><a href="#">All Posts</a></li>
            <li>
              <details>
                <summary>Categories</summary>
                <ul class="p-2 bg-base-100 w-52 z-1">
                  <li><a href="#">Technology</a></li>
                  <li><a href="#">Travel</a></li>
                  <li><a href="#">Lifestyle</a></li>
                  <li><a href="#">Food</a></li>
                  <li><a href="#">Business</a></li>
                </ul>
              </details>
            </li>
            <li><a href="#">About</a></li>
            <li><a href="#">Contact</a></li>
          </ul>
        </div>

        <div class="navbar-end gap-2">
          {% embed 'ww_tailwind_starter:dropdown' with { align: 'end' } %}
            {% block trigger %}
              <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
                <div class="w-10 rounded-full">
                  <img alt="User avatar" src="https://i.pravatar.cc/80?img=12" />
                </div>
              </div>
            {% endblock %}
            {% block menu %}
              <li class="menu-title px-4 py-2">
                <div>
                  <p class="font-semibold">Ivan Zugec</p>
                  <p class="text-xs opacity-60">ivan@zugec.com</p>
                </div>
              </li>
              <div class="divider my-0"></div>
              <li><a href="#" class="justify-between">Profile <span class="badge">New</span></a></li>
              <li><a href="#">Settings</a></li>
              <div class="divider my-0"></div>
              <li><a href="#" class="text-error">Sign out</a></li>
            {% endblock %}
          {% endembed %}

          <label for="mobile-drawer" aria-label="open sidebar" class="btn btn-ghost btn-circle lg:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
          </label>
        </div>
      </div>
    </header>
  {% endblock %}

  {% block sidebar %}
    <div class="flex items-center justify-between mb-8 px-4">
      <div class="flex items-center gap-2">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="text-xl font-bold">WebWash</span>
      </div>
      <label for="mobile-drawer" aria-label="close sidebar" class="btn btn-sm btn-circle btn-ghost">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </label>
    </div>

    <ul class="menu menu-compact">
      <li><a href="#">Home</a></li>
      <li><a href="#">All Posts</a></li>
      <li>
        <h2 class="menu-title">Categories</h2>
        <ul>
          <li><a href="#">Technology</a></li>
          <li><a href="#">Travel</a></li>
          <li><a href="#">Lifestyle</a></li>
          <li><a href="#">Food</a></li>
          <li><a href="#">Business</a></li>
        </ul>
      </li>
      <li><a href="#">About</a></li>
      <li><a href="#">Contact</a></li>
    </ul>
  {% endblock %}
{% endembed %}
