{% set navbar_cva =
  html_cva(
    base: ['navbar'],
    variants: {
      colorPalette: {
        'base-100': 'bg-base-100 text-base-content',
        'base-200': 'bg-base-200 text-base-content',
        'base-300': 'bg-base-300 text-base-content',
        neutral: 'bg-neutral text-neutral-content',
        primary: 'bg-primary text-primary-content',
        secondary: 'bg-secondary text-secondary-content',
        accent: 'bg-accent text-accent-content',
        info: 'bg-info text-info-content',
        success: 'bg-success text-success-content',
        warning: 'bg-warning text-warning-content',
        error: 'bg-error text-error-content'
      }
    }
  )
%}

{% set navbar_classes =
  navbar_cva.apply({
    colorPalette: color_palette|default('base-100')
  })
%}

<div {{ attributes.addClass(navbar_classes) }}>
  <div class="navbar-start">
    {% block navbar_start %}
      {{ navbar_start }}
    {% endblock %}
  </div>

  <div class="navbar-center">
    {% block navbar_center %}
      {{ navbar_center }}
    {% endblock %}
  </div>

  <div class="navbar-end gap-2">
    {% block navbar_end %}
      {{ navbar_end }}
    {% endblock %}

    <button type="button" class="btn btn-square btn-ghost lg:hidden" popovertarget="mm-main" aria-label="Open menu">
      {{
        include(
          'ww_daisyui_starter:icon',
          {
            icon: 'list',
            icon_size: 'medium'
          },
          with_context: false
        )
      }}
    </button>
  </div>
</div>
