{#
/**
 * Section — top-level page wrapper.
 *
 * Background, padding and width are mapped from semantic prop values to
 * Tailwind/daisyUI utility classes. Tokens (e.g. bg-base-200, text-primary-content)
 * keep the section theme-aware out of the box.
 */
#}
{% set bg_class = {
  'default':   '',
  'base-100':  'bg-base-100 text-base-content',
  'base-200':  'bg-base-200 text-base-content',
  'base-300':  'bg-base-300 text-base-content',
  'primary':   'bg-primary text-primary-content',
  'secondary': 'bg-secondary text-secondary-content',
  'accent':    'bg-accent text-accent-content',
  'neutral':   'bg-neutral text-neutral-content',
}[bg|default('default')] %}

{% set padding_class = {
  'none': 'py-0',
  'sm':   'py-8',
  'md':   'py-16',
  'lg':   'py-24',
  'xl':   'py-32',
}[padding|default('md')] %}

{% set width_class = {
  'narrow':    'max-w-3xl mx-auto px-4',
  'container': 'max-w-7xl mx-auto px-4',
  'wide':      'max-w-screen-2xl mx-auto px-4',
  'full':      'w-full',
}[width|default('container')] %}

{% set heading_tag = title_heading_level|default('h2') %}
{% set align_class = align|default('left') == 'center' ? 'text-center mx-auto max-w-3xl' : '' %}

<section class="{{ bg_class }} {{ padding_class }}">
  <div class="{{ width_class }}">
    {% if title or intro %}
      <header class="mb-10 {{ align_class }}">
        {% if title %}
          <{{ heading_tag }} class="text-3xl md:text-4xl font-bold mb-3">
            {{ title }}
          </{{ heading_tag }}>
        {% endif %}
        {% if intro %}
          <p class="text-lg opacity-80">{{ intro }}</p>
        {% endif %}
      </header>
    {% endif %}

    {% block content %}
      {{ content }}
    {% endblock %}
  </div>
</section>
