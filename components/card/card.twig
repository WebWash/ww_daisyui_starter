{# Pair every bg with its matching text token explicitly so cards stay
   readable when nested inside coloured sections (otherwise the parent's
   text-*-content inherits into the card body). #}
{% set bg_class_map = {
  'default':   'bg-base-100 text-base-content',
  'neutral':   'bg-neutral text-neutral-content',
  'primary':   'bg-primary text-primary-content',
  'secondary': 'bg-secondary text-secondary-content',
  'accent':    'bg-accent text-accent-content',
  'info':      'bg-info text-info-content',
  'success':   'bg-success text-success-content',
  'warning':   'bg-warning text-warning-content',
  'error':     'bg-error text-error-content',
} %}
{% set bg_classes = bg_class_map[bg_color|default('default')] ?? 'bg-base-100' %}

{% set classes = [
  'card',
  'shadow-sm',
  'overflow-hidden',
  bg_classes,
  size|default('card-md'),
  border and border != 'none' ? border,
  style and style != 'default' ? style,
] %}

{% set heading_tag = title_heading_level|default('h3') %}

<div {{ attributes.addClass(classes) }}>
  {% if image.src %}
    <figure>
      <img src="{{ image.src }}" alt="{{ image.alt|default('') }}" />
    </figure>
  {% endif %}
  <div class="card-body">
    <{{ heading_tag }} class="card-title">{{ title }}</{{ heading_tag }}>
    {% if body %}
      <p>{{ body }}</p>
    {% endif %}
    {% if action_label %}
      <div class="card-actions justify-end">
        {{ include('ww_tailwind_starter:button', {
          text: action_label,
          url: action_url,
          size: 'btn-sm',
        }, with_context: false) }}
      </div>
    {% endif %}
  </div>
</div>
