{#
/**
 * @file
 * Theme override for a breadcrumb trail.
 *
 * Available variables:
 * - breadcrumb: Breadcrumb trail items (array of { text, url }).
 */
#}
{% if breadcrumb %}
  {{
    include(
      'ww_daisyui_starter:breadcrumb',
      {
        items: breadcrumb
      },
      with_context: false
    )
  }}
{% endif %}
