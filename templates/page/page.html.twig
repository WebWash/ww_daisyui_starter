{#
/**
 * @file
 * Default theme implementation to display a single page.
 *
 * Available variables:
 * - is_edge: TRUE when the page should render edge-to-edge (no container/padding).
 *   Currently set for Canvas-rendered pages and any /ww-demo/* styleguide route.
 * - site_name: The site name from system.site config.
 *
 * @see \Drupal\ww_tailwind_starter\Hook\ThemeHooks::preprocessPage()
 */
#}
{% include 'ww_tailwind_starter:navbar' with {
  logo: page.navbar_branding,
  menu: page.primary_menu,
  site_name: site_name,
} %}

{% if page.breadcrumb %}
  <div class="container mx-auto px-4 py-3">
    {{ page.breadcrumb }}
  </div>
{% endif %}

{% if page.pre_content and not is_edge %}
  <div class="container mx-auto p-4">
    {{ page.pre_content }}
  </div>
{% endif %}

{% set section_classes = is_edge ? 'p-0' : 'p-4' %}
{% set container_classes = is_edge ? '' : 'container mx-auto px-4' %}

<main>
  <a id="main-content" tabindex="-1"></a>
  <section class="{{ section_classes }}">
    <div class="{{ container_classes }}">
      {% if page.content %}
        {{ page.content }}
      {% endif %}
    </div>
  </section>
</main>

{% if page.footer_branding or page.footer or page.footer_social or page.footer_bottom %}
  {{ include('ww_tailwind_starter:footer', {
    branding: page.footer_branding,
    links: page.footer,
    social: page.footer_social,
    bottom: page.footer_bottom,
    bg_color: 'dark',
  }, with_context: false) }}
{% endif %}
