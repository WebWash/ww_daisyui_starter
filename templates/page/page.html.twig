{#
/**
 * @file
 * Default theme implementation to display a single page.
 *
 * Available variables:
 * - is_edge: TRUE when the page should render edge-to-edge (no container/padding).
 *   Currently set for Canvas-rendered pages and any /ww-demo/* styleguide route.
 *
 * @see \Drupal\ww_daisyui_starter\Hook\ThemeHooks::preprocessPage()
 */
#}
{% if page.navbar %}
  <header class="bg-base-100 shadow-sm">
    <div class="container mx-auto px-4 lg:px-8">
      {{ page.navbar }}
    </div>
  </header>
{% endif %}

{% if page.breadcrumb and not is_edge %}
  <div class="container mx-auto px-4 py-3">
    {{ page.breadcrumb }}
  </div>
{% endif %}

{% if page.pre_content and not is_edge %}
  <div class="container mx-auto p-4">
    {{ page.pre_content }}
  </div>
{% endif %}

{% set section_classes = is_edge ? 'p-0' : 'p-4' %}
{% set container_classes = is_edge ? '' : 'container mx-auto px-4' %}

<main class="layout-content">
  <a id="main-content" tabindex="-1"></a>
  <section class="{{ section_classes }}">
    <div class="{{ container_classes }}">
      {% if page.content %}
        {{ page.content }}
      {% endif %}
    </div>
  </section>
</main>

{% if page.footer %}
  {{ page.footer }}
{% endif %}
