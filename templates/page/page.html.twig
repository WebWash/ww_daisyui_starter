<header class="bg-base-100 shadow-sm">
  <div class="navbar container mx-auto px-4 lg:px-8">
    <div class="navbar-start">
      <a href="/" class="btn btn-ghost text-xl font-bold">{{ site_name }}</a>
    </div>

    <div class="navbar-center">
      {% embed 'ww_daisyui_starter:megamenu_v2'
        with {
          items: nav_items,
          id: 'nav',
          width: 'wide',
          mobile: true,
          megamenu_classes: 'p-2'
        } only
      %}
        {% block mobile_bottom %}
          <form action="/search/node" method="get" role="search" class="w-full">
            <label class="input w-full">
              {{
                include(
                  'ww_daisyui_starter:icon',
                  {
                    icon: 'magnifying-glass',
                    icon_size: 'small'
                  },
                  with_context: false
                )
              }}
              <input type="search" name="keys" placeholder="Search" class="grow" />
            </label>
          </form>
        {% endblock %}
      {% endembed %}
    </div>

    <div class="navbar-end gap-2">
      {{ include('ww_daisyui_starter:theme_switcher', {}, with_context: false) }}
      <button type="button" class="btn btn-square btn-ghost lg:hidden" popovertarget="mm2-nav" aria-label="Open menu">
        {{
          include(
            'ww_daisyui_starter:icon',
            {
              icon: 'list',
              icon_size: 'medium'
            },
            with_context: false
          )
        }}
      </button>
    </div>
  </div>
</header>

{% if page.breadcrumb and not is_edge %}
  <div class="container mx-auto px-4 py-3">
    {{ page.breadcrumb }}
  </div>
{% endif %}

{% if page.pre_content and not is_edge %}
  <div class="container mx-auto p-4">
    {{ page.pre_content }}
  </div>
{% endif %}

{% set section_classes = is_edge ? 'p-0' : 'p-4' %}
{% set container_classes = is_edge ? '' : 'container mx-auto px-4' %}

<main class="layout-content">
  <a id="main-content" tabindex="-1"></a>
  <section class="{{ section_classes }}">
    <div class="{{ container_classes }}">
      {% if page.content %}
        {{ page.content }}
      {% endif %}
    </div>
  </section>
</main>

{% if page.footer_branding or page.footer or page.footer_social or page.footer_bottom %}
  {{
    include(
      'ww_daisyui_starter:footer',
      {
        branding: page.footer_branding,
        links: page.footer,
        social: page.footer_social,
        bottom: page.footer_bottom,
        bg_color: 'dark'
      },
      with_context: false
    )
  }}
{% endif %}
