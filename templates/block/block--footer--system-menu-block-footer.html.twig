{#
/**
 * @file
 * Footer menu rendered as daisyUI link columns: each top level item is a
 * column heading, its children are the links below it.
 *
 * Items come from `content['#items']` because `items` is only exposed to menu
 * templates, not block templates.
 *
 * No <nav> wrapper: the footer component already wraps this slot in one.
 */
#}
{% set items = content['#items'] ?? [] %}

{% set heading_id = attributes.id ~ ('-menu'|clean_id) %}

{% set columns_classes = ['grid', 'grid-cols-1', 'gap-8', 'sm:grid-cols-2', 'w-full'] %}

{% set column_title_classes = ['footer-title'] %}

{% set column_list_classes = ['flex', 'flex-col', 'gap-2', 'list-none', 'p-0', 'm-0'] %}

{% if not configuration.label_display %}
  {% set title_attributes = title_attributes.addClass('visually-hidden') %}
{% endif %}

<div {{ attributes|without('role', 'aria-labelledby') }}>
  {{ title_prefix }}
  <h2 {{ title_attributes.setAttribute('id', heading_id) }}>{{ configuration.label }}</h2>
  {{ title_suffix }}

  {% if items %}
    <div class="{{ columns_classes|join(' ') }}">
      {% for item in items %}
        <div>
          {% if item.url.isRouted and item.url.routeName == '<nolink>' %}
            <h6 class="{{ column_title_classes|join(' ') }}">{{ item.title }}</h6>
          {% else %}
            <h6 class="{{ column_title_classes|join(' ') }}">
              {{
                link(
                  item.title,
                  item.url,
                  {
                    class: ['link', 'link-hover']
                  }
                )
              }}
            </h6>
          {% endif %}

          {% if item.below %}
            <ul class="{{ column_list_classes|join(' ') }}">
              {% for child in item.below %}
                <li>
                  {{
                    link(
                      child.title,
                      child.url,
                      {
                        class: ['link', 'link-hover']
                      }
                    )
                  }}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
