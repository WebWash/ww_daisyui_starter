{#
/**
 * @file
 * Theme override: the main menu always renders as the megamenu component.
 *
 * Drupal's processed menu tree (`items`) maps 1:1 onto the component's
 * `items` prop, so this template is the entire integration — the placed
 * "Main navigation" block remains the single source of truth for region,
 * level/depth, "Expand all menu links" (must be enabled so submenus load on
 * every page), access checking and cacheability. No preprocess code needed.
 *
 * Mobile: the component becomes a vertical popover (container id "mm-main")
 * opened by the hamburger button in the navbar component — keep that
 * popovertarget in sync with the `id` prop here.
 */
#}
{{
  include(
    'ww_daisyui_starter:megamenu',
    {
      items: items,
      id: 'main',
      width: 'wide',
      mobile: true,
      megamenu_classes: 'p-2'
    },
    with_context: false
  )
}}
